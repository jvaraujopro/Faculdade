Algoritmo "Aula 2 exercicio 6"
// Disciplina   : BASES DE CIÊNCIA DA COMPUTAÇÃO I - COMPUTAÇÃO
// Professor   : FLÁVIO JOSÉ FERRO BARROS

Var
Ano : Real
Inicio
escreva ("Digite um ano: ")
 leia (Ano)
  se (Ano % 400 = 0) ou (Ano % 4 = 0) e (Ano % 100 <> 0) entao
   escreva ("É um ano bissexto!")
  senao
   escreva ("Não é um ano bissexto!")
    fimse
  


Fimalgoritmo
